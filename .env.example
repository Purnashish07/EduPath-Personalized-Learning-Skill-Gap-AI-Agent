# Backend
PORT=4000
FRONTEND_URL=http://localhost:5173
DEMO_MODE=true
# Use memory only for local demo mode. Production persistence requires postgres.
PERSISTENCE_MODE=memory
# Optional real AI provider (OpenAI-compatible)
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Required by the backend when PERSISTENCE_MODE=postgres.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Required when PERSISTENCE_MODE=postgres; never expose this to frontend code.
DATABASE_URL=
LLM_TIMEOUT_MS=25000
ALLOW_VERCEL_PREVIEW_ORIGINS=false
